// Generated by BIForge from Tableau workbook 'HouseholdProductsSales'

table 'Household Products Sales'
	column 'Order ID'
		dataType: string

	column 'Order Date'
		dataType: dateTime

	column 'Ship Date'
		dataType: dateTime

	column 'Product Name'
		dataType: string

	column 'Product Category'
		dataType: string

	column Brand
		dataType: string

	column Region
		dataType: string

	column Channel
		dataType: string

	column 'Units Sold'
		dataType: int64

	column 'Unit Price'
		dataType: double

	column 'Unit Cost'
		dataType: double

	column Discount
		dataType: double

	column Returned
		dataType: boolean

	column Revenue = ( 'Household Products Sales'[Units Sold] * 'Household Products Sales'[Unit Price] )

	column Profit = ( ( 'Household Products Sales'[Unit Price] - 'Household Products Sales'[Unit Cost] ) * 'Household Products Sales'[Units Sold] )

	column 'Discount Band' = IF ( ( 'Household Products Sales'[Discount] >= 0.3 ), "Deep", IF ( ( 'Household Products Sales'[Discount] >= 0.1 ), "Standard", "None" ) )

	column 'Days to Ship' = DATEDIFF ( 'Household Products Sales'[Order Date], 'Household Products Sales'[Ship Date], DAY )

	column 'Order Year' = YEAR ( 'Household Products Sales'[Order Date] )

	column 'Order Month' = FORMAT ( 'Household Products Sales'[Order Date], "General Date" )

	column 'Category Upper' = UPPER ( 'Household Products Sales'[Product Category] )

	column 'Is Cleaning' = CONTAINSSTRING ( 'Household Products Sales'[Product Category], "Cleaning" )

	column 'Return Flag' = IF ( 'Household Products Sales'[Returned], "Returned", "Kept" )

	column 'Revenue Rank' = INDEX (  )

	measure 'Total Revenue' = SUM ( 'Household Products Sales'[Revenue] )

	measure 'Profit Margin' = ( SUM ( 'Household Products Sales'[Profit] ) / SUM ( 'Household Products Sales'[Revenue] ) )

	measure 'Net Units' = COALESCE ( SUM ( 'Household Products Sales'[Units Sold] ), 0 )


